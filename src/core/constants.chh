#!/usr/bin/chippy
#
# boxflinger - constants.chh
#

#@ <BFVERSION>
#@ (2026-05-31)
#@ Library version

var BFVERSION = "1.0.8";

#@ <BFALIGNLEFT>
#@ (2025-09-28)
#@ Left text alignment

var BFALIGNLEFT = 0;

#@ <BFALIGNCENTER>
#@ (2025-09-28)
#@ Center text alignment

var BFALIGNCENTER = 1;

#@ <BFALIGNRIGHT>
#@ (2025-09-28)
#@ Right text alignment

var BFALIGNRIGHT = 2;

#@ <BFPAGEITEMS>
#@ (2026-06-02)
#@ Number of items to jump when PageUp/PageDown is pressed in non-scrollable
#@ list widgets

var BFPAGEITEMS = 5;

# ---

#@ <BFPACKEDSPACE>
#@ (2025-09-28)
#@ Space character

var BFPACKEDSPACE = pack(" ");

#@ <BFPACKEDBLOCK>
#@ (2025-09-28)
#@ Full block character

var BFPACKEDBLOCK = pack("█");

#@ <BFPACKEDDOT>
#@ (2025-09-28)
#@ Bullet point character

var BFPACKEDDOT = pack("●");

# ---

#@ <BFBOXSINGLE>
#@ (2025-09-28)
#@ Single-line box border style

var BFBOXSINGLE = 1;

var BFPACKEDSINGLETL = pack("┌");
var BFPACKEDSINGLETR = pack("┐");
var BFPACKEDSINGLEBL = pack("└");
var BFPACKEDSINGLEBR = pack("┘");
var BFPACKEDSINGLEH = pack("─");
var BFPACKEDSINGLEV = pack("│");

#@ <BFBOXDOUBLE>
#@ (2025-09-28)
#@ Double-line box border style

var BFBOXDOUBLE = 2;

var BFPACKEDDOUBLETL = pack("╔");
var BFPACKEDDOUBLETR = pack("╗");
var BFPACKEDDOUBLEBL = pack("╚");
var BFPACKEDDOUBLEBR = pack("╝");
var BFPACKEDDOUBLEH = pack("═");
var BFPACKEDDOUBLEV = pack("║");

#@ <BFBOXROUNDED>
#@ (2025-09-28)
#@ Rounded corner box border style

var BFBOXROUNDED = 3;

var BFPACKEDROUNDEDTL = pack("╭");
var BFPACKEDROUNDEDTR = pack("╮");
var BFPACKEDROUNDEDBL = pack("╰");
var BFPACKEDROUNDEDBR = pack("╯");

#@ <BFPACKEDBRACKETLEFT>
#@ (2025-09-30)
#@ Left bracket character for slider visualization

var BFPACKEDBRACKETLEFT = pack("[");

#@ <BFPACKEDBRACKETRIGHT>
#@ (2025-09-30)
#@ Right bracket character for slider visualization

var BFPACKEDBRACKETRIGHT = pack("]");

#@ <BFPACKEDEQUALS>
#@ (2025-09-30)
#@ Filled portion character in slider bar

var BFPACKEDEQUALS = pack("=");

#@ <BFPACKEDDASH>
#@ (2025-09-30)
#@ Empty portion character in slider bar

var BFPACKEDDASH = pack("-");

#@ <BFAPC>
#@ (2026-04-05)
#@ APC start sequence

var BFAPC = b[27, 95];

#@ <BFST>
#@ (2026-04-05)
#@ String terminator

var BFST = b[27, 92];

#@ <BFCELLQUERY>
#@ (2026-04-05)
#@ Cell pixel size query sequence (CSI + BFCELLQUERY)

var BFCELLQUERY = b[49, 54, 116];

#@ <BFISKITTY>
#@ (2026-04-05)
#@ ''true'' if running inside a kitty terminal, ''false'' otherwise

var BFISKITTY = getenv("TERM") == "xterm-kitty";
