#!/usr/bin/chippy
#
# boxflinger - numberinput.chh
#

#@ <BFNumberInput(x, y, prompt, min, max, defaultValue)>
#@ V-1.0.3 (2026-02-02)
#@
#@ Numeric input field with range validation at position ''x'' and ''y''.
#@ Only accepts digits and optional minus sign. The ''prompt'' text has
#@ range appended automatically. The ''min'' and ''max'' define allowed range,
#@ and ''defaultValue'' sets initial value. Returns validated number when
#@ Enter is pressed, or ''err'' if ESC is pressed. Shows error message for 1
#@ second if value outside range. Only supports integers.

func BFNumberInput(x, y, prompt, min, max, defaultValue)
{
	var text = str(int(defaultValue));
	var cursorPos = len(text);
	var running = true;
	var result = err;

	var minStr = str(int(min));
	var maxStr = str(int(max));
	var fullPrompt = prompt + " (" + minStr + "-" + maxStr + "): ";
	var maxInputLen = lenv(minStr);

	if lenv(maxStr) > maxInputLen { maxInputLen = lenv(maxStr); }

	var errorMsg = "Value must be between " + minStr + " and " + maxStr;

	HideCursor();

	while running
	{
		BFClearRegion(x, y, lenv(fullPrompt) + maxInputLen, 1);
		BFDrawText(x, y, fullPrompt);

		var inputX = x + lenv(fullPrompt);

		BFDrawText(inputX, y, text);
		CursorToXY(inputX + cursorPos, y);
		ShowCursor();

		var key = getch();

		HideCursor();

		if key == BFKEYENTER
		{
			if text != ""
			{
				var value = num(text);

				if value >= min and value <= max
				{
					result = value;
					running = false;
				}
				else
				{
					BFDrawText(x, y + 1, errorMsg);

					sleep(1000);

					BFClearRegion(x, y + 1, lenv(errorMsg), 1);
				}
			}
		}
		elseif key == BFKEYESC
		{
			result = err;
			running = false;
		}
		elseif key == BFKEYBACKSPACE
		{
			if cursorPos > 0
			{
				var before = slice(text, 1, cursorPos - 1);
				var after = slice(text, cursorPos + 1, len(text));

				text = before + after;
				cursorPos = cursorPos - 1;
			}
		}
		elseif type(key) == "bytes" and len(key) == 1 and key[1] >= 48 and key[1] <= 57
		{
			var char = unpack(key);
			var before = slice(text, 1, cursorPos);
			var after = slice(text, cursorPos + 1, len(text));

			text = before + char + after;
			cursorPos = cursorPos + 1;
		}
		elseif type(key) == "bytes" and len(key) == 1 and key[1] == 45 and cursorPos == 0
		{
			text = "-" + text;
			cursorPos = 1;
		}
		elseif key == BFKEYLEFT
		{
			if cursorPos > 0
			{
				cursorPos = cursorPos - 1;
			}
		}
		elseif key == BFKEYRIGHT
		{
			if cursorPos < len(text)
			{
				cursorPos = cursorPos + 1;
			}
		}
		elseif key == BFKEYHOME
		{
			cursorPos = 0;
		}
		elseif key == BFKEYEND
		{
			cursorPos = len(text);
		}
		elseif key == BFKEYDELETE
		{
			if cursorPos < len(text)
			{
				var before = slice(text, 1, cursorPos);
				var after = slice(text, cursorPos + 2, len(text));

				text = before + after;
			}
		}
		elseif key == BFKEYUP { }
		elseif key == BFKEYDOWN { }
		elseif key == BFKEYCTRLU
		{
			text = "";
			cursorPos = 0;
		}
	}

	ShowCursor();

	return result;
}
