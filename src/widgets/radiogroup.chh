#!/usr/bin/chippy
#
# boxflinger - radiogroup.chh
#

#@ <BFRadioGroup(x, y, items, defaultIndex)>
#@ V-1.0.3 (2026-04-04)
#@
#@ Radio button group for single selection from multiple options at position
#@ ''x'' and ''y''. The ''items'' array contains strings for each radio
#@ button option and ''defaultIndex'' sets initially selected item. Returns
#@ index of selected item when Enter is pressed, or ''err'' if ESC is
#@ pressed. Displays as "( ) Option" for unselected and "(•) Option" for
#@ selected. Items stacked vertically at consecutive y positions.

func BFRadioGroup(x, y, items, defaultIndex)
{
	var selected = defaultIndex;
	var running = true;
	var result = err;

	if len(items) == 0 { return err; }

	if selected < 1 { selected = 1; }

	if selected > len(items) { selected = len(items); }

	HideCursor();

	for i = 1 to len(items)
	{
		var radio = "( )";

		if i == selected { radio = "(•)"; }

		BFDrawText(x, y + i - 1, radio + " " + items[i]);
	}

	while running
	{
		var prevSelected = selected;
		var key = getch();

		if key == BFKEYENTER
		{
			result = selected;
			running = false;
		}
		elseif key == BFKEYESC
		{
			result = err;
			running = false;
		}
		elseif key == BFKEYUP
		{
			if selected > 1
			{
				selected = selected - 1;
			}
		}
		elseif key == BFKEYDOWN
		{
			if selected < len(items)
			{
				selected = selected + 1;
			}
		}

		if running and selected != prevSelected
		{
			BFDrawText(x, y + prevSelected - 1, "( ) " + items[prevSelected]);
			BFDrawText(x, y + selected - 1, "(•) " + items[selected]);
		}
	}

	ShowCursor();

	return result;
}
