#!/usr/bin/chippy
#
# boxflinger - keybindsbar.chh
#

#@ <BFKeybindsBar(x, y, width, rows)>
#@ V-1.0.1 (2026-08-26)
#@
#@ Draws a keybinds bar at ''x'' and ''y'' spanning ''width'' columns and ''len(rows)''
#@ lines. ''rows'' is a list of rows, each a list of maps with keys ''key'' and
#@ ''action'' drawn centered on its line; an empty row leaves a blank padding line.
#@ Always returns ''ok''.

func _BFKeybindWidth_(key, action)
{
	return lenv(key) + lenv(" " + action + "   ");
}

func _BFDrawKeybind_(x, y, key, action)
{
	SetAttribute(COLORBOLD);
	BFDrawText(x, y, key);
	SetAttribute(COLORRESET);

	SetAttribute(COLORBLACK);
	SetAttribute(COLORBGWHITE);

	var actionX = x + lenv(key);
	var actionText = " " + action + "   ";

	BFDrawText(actionX, y, actionText);

	return actionX + lenv(actionText);
}

func BFKeybindsBar(x, y, width, rows)
{
	SetAttribute(COLORBLACK);
	SetAttribute(COLORBGWHITE);

	var pad = BFPadText("", width, BFALIGNLEFT);

	for r = 1 to len(rows) { BFDrawText(x, y + r - 1, pad); }

	for r = 1 to len(rows)
	{
		var items = rows[r];
		var rowY = y + r - 1;

		var lineWidth = 0;

		for i = 1 to len(items)
		{
			var item = items[i];
			lineWidth = lineWidth + _BFKeybindWidth_(item["key"], item["action"]);
		}

		var xpos = x + int((width - lineWidth) / 2);

		if xpos < x { xpos = x; }

		for i = 1 to len(items)
		{
			var item = items[i];
			xpos = _BFDrawKeybind_(xpos, rowY, item["key"], item["action"]);
		}
	}

	SetAttribute(COLORRESET);

	return ok;
}
