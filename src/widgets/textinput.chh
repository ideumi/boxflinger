#!/usr/bin/chippy
#
# boxflinger - textinput.chh
#

#@ <BFTextInput(x, y, width, prompt, defaultValue)>
#@ V-1.0.4 (2026-04-04)
#@
#@ Single-line text input field with full cursor navigation and editing at
#@ position ''x'' and ''y'' with maximum visible ''width''. The ''prompt'' is
#@ displayed before input field and ''defaultValue'' sets initial text. Returns
#@ entered text when Enter is pressed, or ''err'' if ESC is pressed or width less
#@ than 1. Supports Left/Right arrows, Ctrl+Left/Right, Home/End, Backspace,
#@ Delete, and all printable characters.

func BFTextInput(x, y, width, prompt, defaultValue)
{
	if width < 1 { return err; }

	var text = str(defaultValue);
	var cursorPos = len(text);

	var running = true;
	var result = err;
	var inputX = x + lenv(prompt);

	HideCursor();

	BFDrawText(x, y, prompt);

	var scrollOffset = 0;

	if len(text) > width and cursorPos >= width
	{
		scrollOffset = cursorPos - width + 1;
	}

	var displayText = text;

	if len(text) > width
	{
		displayText = slice(text, scrollOffset + 1, scrollOffset + width);
	}

	BFClearRegion(inputX, y, width, 1);
	BFDrawText(inputX, y, displayText);
	CursorToXY(inputX + cursorPos - scrollOffset, y);
	ShowCursor();

	while running
	{
		var key = getch();

		HideCursor();

		var textChanged = false;

		if key == BFKEYENTER
		{
			result = text;
			running = false;
		}
		elseif key == BFKEYESC
		{
			result = err;
			running = false;
		}
		elseif key == BFKEYBACKSPACE
		{
			if cursorPos > 0
			{
				var before = slice(text, 1, cursorPos - 1);
				var after = slice(text, cursorPos + 1, len(text));

				text = before + after;
				cursorPos = cursorPos - 1;
				textChanged = true;
			}
		}
		elseif key == BFKEYLEFT
		{
			if cursorPos > 0 { cursorPos = cursorPos - 1; }
		}
		elseif key == BFKEYRIGHT
		{
			if cursorPos < len(text) { cursorPos = cursorPos + 1; }
		}
		elseif key == BFKEYCTRLLEFT
		{
			cursorPos = BFPrevWordPos(text, cursorPos);
		}
		elseif key == BFKEYCTRLRIGHT
		{
			cursorPos = BFNextWordPos(text, cursorPos);
		}
		elseif key == BFKEYHOME
		{
			cursorPos = 0;
		}
		elseif key == BFKEYEND
		{
			cursorPos = len(text);
		}
		elseif key == BFKEYDELETE
		{
			if cursorPos < len(text)
			{
				var before = slice(text, 1, cursorPos);
				var after = slice(text, cursorPos + 2, len(text));

				text = before + after;
				textChanged = true;
			}
		}
		elseif key == BFKEYTAB
		{
		}
		elseif key == BFKEYUP
		{
		}
		elseif key == BFKEYDOWN
		{
		}
		elseif key == BFKEYCTRLUP
		{
		}
		elseif key == BFKEYCTRLDOWN
		{
		}
		elseif key == BFKEYCTRLU
		{
			text = "";
			cursorPos = 0;
			textChanged = true;
		}
		elseif type(key) == "bytes" and len(key) >= 1
		{
			var char = unpack(key);

			if len(char) > 0
			{
				var before = slice(text, 1, cursorPos);
				var after = slice(text, cursorPos + 1, len(text));

				text = before + char + after;
				cursorPos = cursorPos + 1;
				textChanged = true;
			}
		}

		if running
		{
			var newScrollOffset = 0;

			if len(text) > width and cursorPos >= width
			{
				newScrollOffset = cursorPos - width + 1;
			}

			if textChanged or newScrollOffset != scrollOffset
			{
				scrollOffset = newScrollOffset;

				var newDisplayText = text;

				if len(text) > width
				{
					newDisplayText = slice(text, scrollOffset + 1, scrollOffset + width);
				}

				BFClearRegion(inputX, y, width, 1);
				BFDrawText(inputX, y, newDisplayText);
			}

			CursorToXY(inputX + cursorPos - scrollOffset, y);
			ShowCursor();
		}
	}

	ShowCursor();
	return result;
}
