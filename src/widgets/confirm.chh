#!/usr/bin/chippy
#
# boxflinger - confirm.chh
#

#@ <BFConfirm(x, y, message, defaultYes)>
#@ V-1.0.2 (2026-04-04)
#@
#@ Yes/No confirmation dialog with button navigation at position ''x'' and
#@ ''y''. The ''message'' is displayed above buttons and ''defaultYes''
#@ determines initially selected button. Returns ''true'' if Yes is
#@ confirmed (Enter on Yes button or 'y'/'Y' key), ''false'' if No is
#@ confirmed (Enter on No button or 'n'/'N' key), or ''err'' if ESC is
#@ pressed. Selected button shown with inverted colors. Buttons displayed
#@ as [ Yes ] and [ No ].

func BFConfirm(x, y, message, defaultYes)
{
	var selected = 1;

	if not defaultYes { selected = 2; }

	var running = true;
	var result = err;
	var buttonY = y + 2;
	var yesButtonWidth = 7;

	HideCursor();

	BFDrawText(x, y, message);
	BFDrawButton(x, buttonY, "Yes", selected == 1);
	BFDrawButton(x + yesButtonWidth, buttonY, "No", selected == 2);

	while running
	{
		var prevSelected = selected;
		var key = getch();

		if key == BFKEYENTER
		{
			if selected == 1
			{
				result = true;
			}
			else
			{
				result = false;
			}

			running = false;
		}
		elseif key == BFKEYESC
		{
			result = err;
			running = false;
		}
		elseif key == BFKEYLEFT
		{
			selected = 1;
		}
		elseif key == BFKEYRIGHT
		{
			selected = 2;
		}
		elseif type(key) == "bytes" and len(key) == 1 and (key[1] == 121 or key[1] == 89)
		{
			result = true;
			running = false;
		}
		elseif type(key) == "bytes" and len(key) == 1 and (key[1] == 110 or key[1] == 78)
		{
			result = false;
			running = false;
		}

		if running and selected != prevSelected
		{
			BFDrawButton(x, buttonY, "Yes", selected == 1);
			BFDrawButton(x + yesButtonWidth, buttonY, "No", selected == 2);
		}
	}

	ShowCursor();

	return result;
}
