#!/usr/bin/chippy
#
# boxflinger - text.chh
#

#@ <BFClipText(text, maxWidth)>
#@ V-1.0.2 (2025-11-04)
#@
#@ Truncates ''text'' to fit within ''maxWidth'' characters, adding ellipsis if
#@ truncated. Returns original text if fits, otherwise truncated with "..."
#@ appended.

func BFClipText(text, maxWidth)
{
	var textStr = str(text);
	var textLen = lenv(textStr);

	if textLen <= maxWidth { return textStr; }

	if maxWidth <= 3 { return slice(textStr, 1, maxWidth); }

	return slice(textStr, 1, maxWidth - 3) + "...";
}

#@ <BFTruncateMiddle(text, maxWidth)>
#@ V-1.0.2 (2025-11-04)
#@
#@ Truncates ''text'' in the middle while preserving start and end portions to
#@ fit within ''maxWidth'' characters. Returns original text if fits, otherwise
#@ "start...end" format. If maxWidth is 3 or less, truncates without ellipsis.
#@ Left side gets floor(available/2) chars, right side gets remainder.

func BFTruncateMiddle(text, maxWidth)
{
	var textStr = str(text);
	var textLen = lenv(textStr);

	if textLen <= maxWidth { return textStr; }

	if maxWidth <= 3 { return slice(textStr, 1, maxWidth); }

	var ellipsis = "...";
	var availableSpace = maxWidth - 3;
	var leftChars = int(availableSpace / 2);
	var rightChars = availableSpace - leftChars;

	var leftPart = slice(textStr, 1, leftChars);
	var actualLen = len(textStr);
	var rightPart = slice(textStr, actualLen - rightChars + 1, actualLen);

	return leftPart + ellipsis + rightPart;
}

#@ <BFPadText(text, width, align)>
#@ V-1.0.2 (2025-11-04)
#@
#@ Pads ''text'' with spaces to reach specified ''width'' with alignment mode
#@ ''align''. Alignment can be ''BFALIGNLEFT'' (adds spaces to right),
#@ ''BFALIGNRIGHT'' (adds spaces to left), or ''BFALIGNCENTER'' (distributes
#@ spaces, left gets floor(padding/2)). Returns padded text at specified width,
#@ or original if already at or exceeds width.

func BFPadText(text, width, align)
{
	var textStr = str(text);
	var textLen = lenv(textStr);

	if textLen >= width { return textStr; }

	var padding = width - textLen;

	if align == BFALIGNLEFT
	{
		return textStr + (" " * padding);
	}
	elseif align == BFALIGNRIGHT
	{
		return (" " * padding) + textStr;
	}
	elseif align == BFALIGNCENTER
	{
		var leftPad = int(padding / 2);
		var rightPad = padding - leftPad;

		return (" " * leftPad) + textStr + (" " * rightPad);
	}
	else
	{
		return textStr;
	}
}

#@ <BFMeasureText(text)>
#@ V-1.0.2 (2025-11-03)
#@
#@ Measures the display width of ''text'' in terminal columns.

func BFMeasureText(text)
{
	return lenv(str(text));
}

#@ <BFNextWordPos(text, pos)>
#@ V-1.0.0 (2026-05-04)
#@
#@ Returns the index at the end of the next word in ''text'' after ''pos''.

func BFNextWordPos(text, pos)
{
	var textLength = len(text);
	var charIndex = pos;

	while charIndex < textLength and charat(text, charIndex + 1) == " "
	{
		charIndex = charIndex + 1;
	}

	while charIndex < textLength and charat(text, charIndex + 1) != " "
	{
		charIndex = charIndex + 1;
	}

	return charIndex;
}

#@ <BFPrevWordPos(text, pos)>
#@ V-1.0.0 (2026-05-04)
#@
#@ Returns the index at the start of the previous word in ''text'' before ''pos''.

func BFPrevWordPos(text, pos)
{
	var charIndex = pos;

	while charIndex > 0 and charat(text, charIndex) == " "
	{
		charIndex = charIndex - 1;
	}

	while charIndex > 0 and charat(text, charIndex) != " "
	{
		charIndex = charIndex - 1;
	}

	return charIndex;
}

#@ <BFWrapText(text, width)>
#@ V-1.0.4 (2026-06-20)
#@
#@ Wraps ''text'' into multiple lines based on word boundaries and ''width''
#@ limit. Returns list of text lines, each at or under ''width'' characters when
#@ possible.

func BFWrapText(text, width)
{
	var paragraphs = split(str(text), "\n");
	var lines = [];

	for paragraphIndex = 1 to len(paragraphs)
	{
		var words = split(paragraphs[paragraphIndex], " ");
		var currentLine = "";

		for wordIndex = 1 to len(words)
		{
			var word = words[wordIndex];

			if lenv(currentLine) == 0
			{
				currentLine = word;
			}
			else
			{
				var joined = currentLine + " " + word;

				if lenv(joined) <= width
				{
					currentLine = joined;
				}
				else
				{
					append(lines, currentLine);
					currentLine = word;
				}
			}
		}

		append(lines, currentLine);
	}

	return lines;
}
