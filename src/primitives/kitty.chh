#!/usr/bin/chippy
#
# boxflinger - kitty.chh
#

# https://sw.kovidgoyal.net/kitty/graphics-protocol/

func _BFKittySend_(cmd)
{
	fwrite(BFAPC + pack(cmd) + BFST, STDOUT);
}

#@ <BFKittyClearImages()>
#@ V-1.0.0 (2026-04-05)
#@
#@ Removes all kitty images from the terminal screen.

func BFKittyClearImages()
{
	_BFKittySend_("Ga=d,d=A");
}

#@ <BFKittyDrawImage(x, y, imagePath, cols, rows)>
#@ V-1.0.0 (2026-04-05)
#@
#@ Draws an image at terminal cell position ''x'', ''y'' spanning ''cols'' by
#@ ''rows'' cells. ''imagePath'' must be an absolute file path.

func BFKittyDrawImage(x, y, imagePath, cols, rows)
{
	CursorToXY(x, y);

	var b64path = HttpBase64Encode(pack(imagePath));

	_BFKittySend_("Ga=T,f=100,t=f,c=" + str(cols) + ",r=" + str(rows) + ";" + b64path);
}

#@ <BFKittyGetCellPixelSize()>
#@ V-1.0.0 (2026-04-05)
#@
#@ Returns the pixel dimensions of one terminal cell as ''[cellW, cellH]'', or
#@ ''err'' if the terminal does not support the query ''ESC[16t''.

func BFKittyGetCellPixelSize()
{
	var saved = getterm();

	if iserr(saved) { return err; }

	setterm(MakeRaw(saved));

	fwrite(CSI + BFCELLQUERY, STDOUT);

	var resp = "";
	var ch = fread(STDIN, 1);

	while not iserr(ch) and ch[1] != 116
	{
		resp = resp + unpack(ch);
		ch = fread(STDIN, 1);
	}

	setterm(saved);

	var parts = split(resp, ";");

	if len(parts) != 3 { return err; }

	var cellH = num(parts[2]);
	var cellW = num(parts[3]);

	if cellH <= 0 or cellW <= 0 { return err; }

	return [int(cellW), int(cellH)];
}

#@ <BFKittyDrawImageAuto(x, y, imagePath, cols)>
#@ V-1.0.0 (2026-04-05)
#@
#@ Draws an image at terminal cell position ''x'', ''y'' spanning ''cols'' cells
#@ wide. Row count is computed automatically by the terminal to preserve the image
#@ aspect ratio. ''imagePath'' must be an absolute file path.

func BFKittyDrawImageAuto(x, y, imagePath, cols)
{
	CursorToXY(x, y);

	var b64path = HttpBase64Encode(pack(imagePath));

	_BFKittySend_("Ga=T,f=100,t=f,c=" + str(cols) + ";" + b64path);
}
