#!/usr/bin/chippy
#
# boxflinger - layout.chh
#

#@ <BFHSplit(width, ratios)>
#@ V-1.0.2 (2026-06-14)
#@
#@ Splits a horizontal ''width'' proportionally based on ''ratios'' array of
#@ positive numbers. Returns list of calculated widths. Ratios are normalized
#@ automatically (e.g., [1, 2, 1] gives 25%, 50%, 25% of total width). Last
#@ column gets any remaining pixels from rounding. Returns ''err'' if ratios is
#@ empty, contains negative values, or sum is zero.

func BFHSplit(width, ratios)
{
	if len(ratios) == 0 { return err; }

	var totalRatio = 0;
	var result = [];

	for i = 1 to len(ratios)
	{
		var ratio = ratios[i];

		if ratio < 0 { return err; }

		totalRatio = totalRatio + ratio;
	}

	if totalRatio == 0 { return err; }

	var remaining = width;

	for i = 1 to len(ratios) - 1
	{
		var proportion = ratios[i] / totalRatio;
		var colWidth = int(width * proportion);

		append(result, colWidth);
		remaining = remaining - colWidth;
	}

	append(result, remaining);

	return result;
}

#@ <BFVSplit(height, ratios)>
#@ V-1.0.2 (2026-06-14)
#@
#@ Splits a vertical ''height'' proportionally based on ''ratios'' array of
#@ positive numbers. Returns list of calculated heights. Ratios are normalized
#@ automatically (e.g., [2, 1, 1] gives 50%, 25%, 25% of total height). Last row
#@ gets any remaining pixels from rounding. Useful for creating multi-row layouts.
#@ Returns ''err'' if ratios is empty, contains negative values, or sum is zero.

func BFVSplit(height, ratios)
{
	if len(ratios) == 0 { return err; }

	var totalRatio = 0;
	var result = [];

	for i = 1 to len(ratios)
	{
		var ratio = ratios[i];

		if ratio < 0 { return err; }

		totalRatio = totalRatio + ratio;
	}

	if totalRatio == 0 { return err; }

	var remaining = height;

	for i = 1 to len(ratios) - 1
	{
		var proportion = ratios[i] / totalRatio;
		var rowHeight = int(height * proportion);

		append(result, rowHeight);
		remaining = remaining - rowHeight;
	}

	append(result, remaining);

	return result;
}

#@ <BFCenterRect(region, dialogWidth, dialogHeight)>
#@ V-1.0.0 (2026-05-29)
#@
#@ Returns the top left ''[x, y]'' position for a dialog of ''dialogWidth'' by
#@ ''dialogHeight'' that is centered within ''region'': ''[x, y, width, height]''.
#@ If the dialog is larger than the region in either axis, the result is clamped
#@ to the region's origin so it remains visible.

func BFCenterRect(region, dialogWidth, dialogHeight)
{
	var rx = region[1];
	var ry = region[2];
	var width = region[3];
	var height = region[4];

	var x = rx + int((width - dialogWidth) / 2);
	var y = ry + int((height - dialogHeight) / 2);

	if x < rx { x = rx; }
	if y < ry { y = ry; }

	return [x, y];
}
