#!/usr/bin/chippy
#
# boxflinger - layout.chh
#

#@ <BFHSplit(width, ratios)>
#@ V-1.0.1 (2025-11-03)
#@
#@ Splits a horizontal ''width'' proportionally based on ''ratios'' array
#@ of positive numbers. Returns list of calculated widths. Ratios are
#@ normalized automatically (e.g., [1, 2, 1] gives 25%, 50%, 25% of total
#@ width). Last column gets any remaining pixels from rounding. Returns
#@ ''err'' if ratios is empty, contains negative values, or sum is zero.

func BFHSplit(width, ratios)
{
	if len(ratios) == 0 { return err; }

	var totalRatio = 0;
	var result = [];

	for i = 1 to len(ratios)
	{
		var ratio = ratios[i];

		if ratio < 0 { return err; }

		totalRatio = totalRatio + ratio;
	}

	if totalRatio == 0 { return err; }

	var remaining = width;

	for i = 1 to len(ratios) - 1
	{
		var proportion = ratios[i] / totalRatio;
		var colWidth = int(width * proportion);

		result = append(result, colWidth);
		remaining = remaining - colWidth;
	}

	result = append(result, remaining);

	return result;
}

#@ <BFVSplit(height, ratios)>
#@ V-1.0.1 (2025-11-03)
#@
#@ Splits a vertical ''height'' proportionally based on ''ratios'' array
#@ of positive numbers. Returns list of calculated heights. Ratios are
#@ normalized automatically (e.g., [2, 1, 1] gives 50%, 25%, 25% of total
#@ height). Last row gets any remaining pixels from rounding. Useful for
#@ creating multi-row layouts. Returns ''err'' if ratios is empty, contains
#@ negative values, or sum is zero.

func BFVSplit(height, ratios)
{
	if len(ratios) == 0 { return err; }

	var totalRatio = 0;
	var result = [];

	for i = 1 to len(ratios)
	{
		var ratio = ratios[i];

		if ratio < 0 { return err; }

		totalRatio = totalRatio + ratio;
	}

	if totalRatio == 0 { return err; }

	var remaining = height;

	for i = 1 to len(ratios) - 1
	{
		var proportion = ratios[i] / totalRatio;
		var rowHeight = int(height * proportion);

		result = append(result, rowHeight);
		remaining = remaining - rowHeight;
	}

	result = append(result, remaining);

	return result;
}
