	if iserr(selected)
	{
		BFDrawText(4, 14, "Selection cancelled");
	}
	else
	{
		BFDrawText(4, 14, "You selected: " + items[selected]);
	}

	BFDrawText(4, 15, "Press any key to continue...");
	ShowCursor();

	getch();
