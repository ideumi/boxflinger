func TestTextBox()
{
	ClearScreen();
	HideCursor();

	BFDrawFrame(2, 2, 70, 20, "TextBox Test", BFBOXSINGLE);

	BFDrawText(4, 4, "This tests multi-line text editor with scrolling.");
	BFDrawText(4, 5, "Use arrow keys to navigate, Enter for new line.");
	BFDrawText(4, 6, "Backspace to delete. Ctrl+D to finish, ESC to cancel.");

	var defaultText = "Sample text.";

	var text = BFTextBox(10, 8, 50, 12, "Text Editor", defaultText, BFBOXSINGLE);

	if iserr(text)
	{
		BFDrawText(4, 22, "Editing cancelled");
	}
	else
	{
		var lines = split(text, "\n");
		BFDrawText(4, 22, "You entered " + str(len(lines)) + " lines (" + str(len(text)) + " chars)");
	}

	BFDrawText(4, 23, "Press any key to continue...");
	ShowCursor();

	getch();
}

func ShowMenu()
{
	ClearScreen();
	HideCursor();

	var logoPath = JoinPath(getcwd(), "/../../media/bflogo/bflogo.png");

	var logoFileExists = IsFile(logoPath);

	var kitty = BFISKITTY and logoFileExists;

	var menuY = 2;
	var menuH = 22;

	if kitty
	{
		BFKittyClearImages();
		menuY = 8;
		menuH = 18;
	}

	if kitty
	{
		BFKittyRenderImage(22, 2, logoPath, 300, 92);
	}

	BFDrawFrame(15, menuY, 50, menuH, "Boxflinger Test", BFBOXSINGLE);

	BFDrawText(17, menuY + 2, "Choose a test:");
	BFDrawText(17, menuY + 4, " 1. TextInput");
	BFDrawText(17, menuY + 5, " 2. Select");
	BFDrawText(17, menuY + 6, " 3. Menu");
	BFDrawText(17, menuY + 7, " 4. Confirm Dialog");
	BFDrawText(17, menuY + 8, " 5. NumberInput");
	BFDrawText(17, menuY + 9, " 6. Slider");
	BFDrawText(17, menuY + 10, " 7. CheckboxList");
	BFDrawText(17, menuY + 11, " 8. RadioGroup");
	BFDrawText(17, menuY + 12, " 9. TextBox");
	BFDrawText(17, menuY + 13, " A. Form Demo");
	BFDrawText(17, menuY + 14, " 0. Exit");

	BFDrawText(17, menuY + 16, "Press 1-9, A, 0 (exit), or Q to select:");

	var key = getch();
	var choice = unpack(key);

	ShowCursor();

	if choice == "1"
	{
		TestTextInput();
	}
	elseif choice == "2"
	{
		TestSelect();
	}
	elseif choice == "3"
	{
		TestMenu();
	}
	elseif choice == "4"
	{
		TestConfirm();
	}
	elseif choice == "5"
	{
		TestNumberInput();
	}
	elseif choice == "6"
	{
		TestSlider();
	}
	elseif choice == "7"
	{
		TestCheckboxList();
	}
	elseif choice == "8"
	{
		TestRadioGroup();
	}
	elseif choice == "9"
	{
		TestTextBox();
	}
	elseif choice == "a" or choice == "A"
	{
		TestForm();
	}
	elseif choice == "0" or choice == "q" or choice == "Q"
	{
		return false;
	}

	return true;
}

func Main()
{
	SetTitle("Boxflinger Demo");

	while ShowMenu() { }

	ClearScreen();
	ShowCursor();
}

Main();
