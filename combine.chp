#!/usr/bin/chippy
#
# Combine configuration file
#

load("src/core/constants.chh");

# Metadata

var Project = "boxflinger";
var Version = BFVERSION;
var Licence = "LICENCE.txt";
var Output = "out/libboxflinger.chh";

# Entry point

var Source = "src/boxflinger.chh";

# Search paths for dependencies

var Paths = [];
Paths = Paths + ["src"];
Paths = Paths + ["src/core"];
Paths = Paths + ["src/primitives"];
Paths = Paths + ["src/widgets"];

# Add user-local library path if HOME is available

var homePath = getenv("HOME");

if not iserr(homePath)
{
	Paths = Paths + [homePath + "/.local/share/chippy/lib"];
}

Paths = Paths + ["/usr/lib/chippy"];

# Dependencies combine shouldn't bundle and just keep as loads

var External = [];
External = External + ["libterm.chh"];
External = External + ["libhandles.chh"];
External = External + ["libprint.chh"];
External = External + ["libhttp.chh"];

# Options

var Compile = false;
var AddShebang = true;

var StripComments = false;
var StripWhitespace = false;
